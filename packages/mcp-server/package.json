{
  "name": "@clewwiki/mcp-server",
  "version": "0.4.0",
  "description": "MCP server for clewwiki: the wiki tools an AI coding agent calls, wrapping the clewwiki REST API.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Dodecaidr/clewwiki#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dodecaidr/clewwiki.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/Dodecaidr/clewwiki/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "clewwiki-mcp": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
