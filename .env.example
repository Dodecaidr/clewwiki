# Copy this file to `.env` and fill in every value. `.env` is never committed.
# The three secrets and BETTER_AUTH_URL have no working default: docker compose
# refuses to start and names the variable rather than silently running an
# insecure instance. Everything else may stay as it is.
#
# docker compose reads this file to fill in docker-compose.yml, and passes the
# application only the variables that file lists. A variable added here that
# compose does not mention never reaches the container.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Password for the bundled PostgreSQL container. Secret, and required.
# Generate with: openssl rand -hex 32
# Use hex, not base64: compose places it inside a connection URL, where the
# `/`, `+` and `=` of base64 break parsing. It is applied when the database
# volume is first created; changing it later does not change the password
# PostgreSQL already stores.
POSTGRES_PASSWORD=

# Optional; both default to `clewwiki`. Not secret.
POSTGRES_USER=
POSTGRES_DB=

# PostgreSQL connection string used by the app and by Drizzle migrations.
# Secret. docker compose builds this from the three values above, so you only
# need to set it when running the app outside compose, for example:
#   postgres://clewwiki:PASSWORD@localhost:5432/clewwiki
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Signs session cookies and tokens. Secret, and required.
# Generate with: openssl rand -base64 48
# Changing it invalidates every existing session.
BETTER_AUTH_SECRET=

# Public base URL the instance is reached at, including scheme. Not secret.
# Must match what the browser sees, or sign-in cookies are rejected. Use the
# https:// address of your reverse proxy in any deployment that has one;
# secure cookies are enabled automatically when this starts with https://.
BETTER_AUTH_URL=http://localhost:3000

# One-time token that first-run setup (/setup) requires, so that only someone
# who operates this server can create the administrator account. Secret while
# no account exists; meaningless afterwards. Leave empty and the app generates
# a random token at start-up and prints it once to its log:
#   docker compose logs web | grep "setup token"
# Or set your own: openssl rand -hex 24
CLEWWIKI_SETUP_TOKEN=

# The request header your reverse proxy sets to the client's IP address. Not
# secret. Login rate limits (per client) key on it. The proxy MUST overwrite
# this header with the address it accepted the connection from, or a client
# can choose its own address; the README shows the line for Caddy and nginx
# (Traefik does it by default). Default: x-real-ip. X-Forwarded-For is never
# trusted. Without the header, all clients share one login bucket.
TRUSTED_CLIENT_IP_HEADER=x-real-ip

# ---------------------------------------------------------------------------
# Rate limiting for agent tokens
# ---------------------------------------------------------------------------

# Requests allowed per token per window, and the window length in seconds.
# Not secret. Defaults: 60 requests per 60 seconds. Browser sessions are not
# rate limited. The counter lives in the application process, so running more
# than one replica multiplies the effective ceiling.
AGENT_TOKEN_RATE_LIMIT_MAX=60
AGENT_TOKEN_RATE_LIMIT_WINDOW=60

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------

# Which published tag of ghcr.io/dodecaidr/clewwiki to run. Not secret.
# Defaults to `latest`; pin an exact version (e.g. `0.1.0`) in production so
# an upgrade is a deliberate `docker compose pull` rather than whatever
# `latest` happens to point at that day. Ignored when building from source
# with docker-compose.build.yml.
CLEWWIKI_VERSION=latest

# ---------------------------------------------------------------------------
# Host binding
# ---------------------------------------------------------------------------

# Where compose publishes the application. Not secret.
# The default binds to loopback only, so a reverse proxy on the same host can
# reach it and nothing else can. The application speaks plain HTTP: change this
# only to put a proxy on another machine in front of it, and then to a private
# network address rather than 0.0.0.0.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------

# Set to `false` to stop the app applying pending migrations on start-up and
# manage the schema yourself with `pnpm db:migrate`. Not secret.
RUN_MIGRATIONS_ON_START=

# Overrides where the app looks for migration SQL. Not secret. Set by the
# Docker image; only relevant when running the app outside a container.
CLEWWIKI_MIGRATIONS_DIR=

# How often the server releases claims whose lease has run out, in seconds
# (default 60, `0` disables the sweep). Expiry is also applied on access, so
# this only decides how quickly an abandoned claim stops occupying its page.
# Not secret.
CLAIM_SWEEP_INTERVAL_SECONDS=

# ---------------------------------------------------------------------------
# Doc↔code anchors
# ---------------------------------------------------------------------------

# Where the server keeps a read-only mirror of each workspace's source
# repository, one bare clone per workspace. Not secret. Defaults to
# `/data/repos`, which docker compose backs with a named volume; set it only
# when running the app outside compose. No working tree is ever created there.
REPOS_DIR=

# Overrides where the app looks for the tree-sitter grammar `.wasm` files. Not
# secret. Set by the Docker image; only relevant outside a container.
CLEWWIKI_GRAMMARS_DIR=

# Set to `true` to let a workspace link a `file://` repository — a git
# repository on this machine or mounted into the container. Not secret. Off by
# default: a file URL reads any repository the app's user can see.
ALLOW_FILE_REPOSITORIES=false

# Access token for a private repository, sent only to https:// URLs. Secret.
# A space's repository setting names the variable to use, and may name only
# CLEWWIKI_GIT_TOKEN or CLEWWIKI_GIT_TOKEN_<NAME> (A-Z, 0-9) — never any other
# variable of this process. docker compose passes CLEWWIKI_GIT_TOKEN through;
# for a CLEWWIKI_GIT_TOKEN_<NAME>, also add its line under `web.environment`
# in docker-compose.yml (or an override file). The token never reaches the
# database.
CLEWWIKI_GIT_TOKEN=

# ---------------------------------------------------------------------------
# MCP over streamable HTTP (for agents that do not run on a developer machine)
# ---------------------------------------------------------------------------

# Mounts the MCP endpoint at /mcp. Off by default: while off, /mcp answers 404.
# Agents on a developer machine do not need this; they use the stdio server.
MCP_HTTP_ENABLED=false

# Comma-separated browser origins allowed to call /mcp. Empty means no browser
# origin is allowed; requests without an Origin header (CLI agents, CI) pass.
MCP_HTTP_ALLOWED_ORIGINS=

# Where the /mcp endpoint reaches this app's own REST API. Defaults to
# http://127.0.0.1:$PORT so the call never leaves the container. Not passed
# through by docker compose; only relevant when running the app outside it.
MCP_INTERNAL_BASE_URL=

# ---------------------------------------------------------------------------
# stdio MCP server (on the developer machine, not on the server)
# ---------------------------------------------------------------------------
# The stdio server reads CLEWWIKI_URL and CLEWWIKI_TOKEN from the agent host's
# environment, not from this file. It refuses a plain http:// CLEWWIKI_URL
# unless the host is localhost or 127.0.0.1, because the token would cross the
# network unencrypted; CLEWWIKI_ALLOW_INSECURE_URL=true overrides that.
