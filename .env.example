# PostgreSQL connection string used by the app and by Drizzle migrations.
DATABASE_URL=

# Secret used by better-auth to sign cookies and tokens. Generate a real
# random value for any non-local deployment; never reuse this placeholder.
BETTER_AUTH_SECRET=

# Public base URL that better-auth uses for callbacks and cookie scoping.
BETTER_AUTH_URL=

# Public base URL of the deployed application (used for links in exports,
# emails, etc.).
APP_BASE_URL=

# Enables the MCP streamable HTTP transport. Keep disabled unless you
# specifically need remote MCP access over HTTP.
MCP_HTTP_ENABLED=false

# Application log verbosity: error | warn | info | debug.
LOG_LEVEL=info
